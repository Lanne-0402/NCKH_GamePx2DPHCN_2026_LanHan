[node name="Instructions" type="Label" parent="UI/InstructionPanel/MarginContainer/VBoxContainer"]
layout_mode = 2
theme_override_font_sizes/font_size = 17
text = "1. Cánh tay gấp 90°, cẳng tay nâng ngang bằng vai.\n2. Hai bàn tay nắm úp vào nhau, hướng lên trên.\n3. Khi tường gai dừng, dạng hai cánh tay sang hai bên nhiều nhất có thể.\n4. Giữ đúng tư thế đủ 5 giây để sóng năng lượng đẩy tường lùi.\n5. Hoàn thành 2 phase × 5 lần; nghỉ 30 giây giữa phase."
autowrap_mode = 2

[node name="SafetyNote" type="Label" parent="UI/InstructionPanel/MarginContainer/VBoxContainer"]
layout_mode = 2
theme_override_colors/font_color = Color(0.78, 0.18, 0.10, 1)
theme_override_font_sizes/font_size = 15
text = "Tường gai luôn dừng ở vị trí an toàn. Mất tracking sẽ tự động tạm dừng."
horizontal_alignment = 1

