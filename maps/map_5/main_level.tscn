[node name="Instructions" type="Label" parent="UI/InstructionPanel/MarginContainer/VBoxContainer"]
layout_mode = 2
theme_override_font_sizes/font_size = 17
text = "1. Thả lỏng vai, dùng cẳng tay bên còn lại kéo nhẹ tay qua ngực.\n2. Giữ căng 30 giây — không gây áp lực lên khuỷu tay.\n3. Nhận 50 điểm thưởng khi giữ đủ.\n4. Thư giãn 30 giây, sau đó đổi sang tay còn lại.\n5. Đứng yên trong suối nước nóng cho đến khi hoàn thành."
autowrap_mode = 2

[node name="SafetyNote" type="Label" parent="UI/InstructionPanel/MarginContainer/VBoxContainer"]
